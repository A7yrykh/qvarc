{
  "sourceLanguage": "en",
  "strings": {
    "%@ per year, renews automatically. Cancel anytime in Settings › Apple ID › Subscriptions at least 24 hours before the end of the period.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al año, se renueva automáticamente. Cancela cuando quieras en Ajustes › ID de Apple › Suscripciones al menos 24 horas antes del final del periodo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ в год, продлевается автоматически. Отменить можно в Настройки › Apple ID › Подписки не позднее чем за 24 часа до конца периода."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ на рік, подовжується автоматично. Скасувати можна в Параметри › Apple ID › Підписки не пізніше ніж за 24 години до кінця періоду."
          }
        }
      }
    },
    "%@ – now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – ahora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – сейчас"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – зараз"
          }
        }
      }
    },
    "%@: %lld days left in the Schengen area. Leave by %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: te quedan %2$lld días en el espacio Schengen. Sal antes del %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: в Шенгене осталось дней: %2$lld. Выезд до %3$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: у Шенгені лишилося днів: %2$lld. Виїзд до %3$@."
          }
        }
      }
    },
    "%@: in 14 days you will reach 183 days in %@ this year.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: dentro de 14 días llegarás a 183 días en %2$@ este año."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: через 14 дней наберётся 183 дня в стране %2$@ за этот год."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: через 14 днів набереться 183 дні в країні %2$@ за цей рік."
          }
        }
      }
    },
    "%@: today is the last day you can stay in the Schengen area.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: hoy es el último día que puedes estar en el espacio Schengen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: сегодня последний день, когда можно находиться в Шенгене."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: сьогодні останній день, коли можна перебувати в Шенгені."
          }
        }
      }
    },
