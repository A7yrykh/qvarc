    "90/180 & 183 helps you estimate your days. It is not legal or tax advice, and the official count at the border or by the tax authority prevails.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "90/180 & 183 te ayuda a estimar tus días. No es asesoramiento legal ni fiscal; prevalece el recuento oficial en frontera o de la autoridad fiscal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "90/180 & 183 помогает оценить ваши дни. Это не юридическая и не налоговая консультация; приоритет у официального подсчёта на границе и налоговой службы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "90/180 & 183 допомагає оцінити ваші дні. Це не юридична і не податкова консультація; пріоритет має офіційний підрахунок на кордоні та податкової служби."
          }
        }
      }
    },
