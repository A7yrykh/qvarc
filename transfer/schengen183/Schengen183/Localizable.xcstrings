    "Count your days in every country per calendar year or the last 12 months, get a warning before 183 days and export a PDF report for your tax adviser.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta tus días en cada país por año natural o últimos 12 meses, recibe un aviso antes de 183 días y exporta un informe PDF para tu asesor fiscal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Считайте дни в каждой стране за календарный год или 12 месяцев, получайте предупреждение до 183 дней и выгружайте PDF-отчёт для налогового консультанта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахуйте дні в кожній країні за календарний рік або 12 місяців, отримуйте попередження до 183 днів і вивантажуйте PDF-звіт для податкового консультанта."
          }
        }
      }
    },
