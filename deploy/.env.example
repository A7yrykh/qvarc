# Скопируйте в deploy/.env и заполните. Файл .env хранится только на сервере, в репозиторий и переписку не попадает.

# Адреса (кварц.рус в записи для браузеров: xn--80adx0a4a.xn--p1acf). В DNS каждый должен указывать на IP сервера.
ADMIN_HOST=admin.xn--80adx0a4a.xn--p1acf
BOOKING_HOST=book.xn--80adx0a4a.xn--p1acf
API_HOST=api.xn--80adx0a4a.xn--p1acf

# Пароль базы: openssl rand -hex 24
POSTGRES_PASSWORD=

# Ключ шифрования паспортных данных: openssl rand -base64 32. Потеря ключа = потеря паспортных данных, храните копию отдельно.
DOCUMENTS_KEY=

# Владелец для первого входа в админку (используется один раз, при первичной загрузке)
QVARC_LEGAL_NAME=ИП Сырых Наталья Рафаиловна
QVARC_PROPERTY_NAME=Место отдыха Кварц
QVARC_OWNER_NAME=
QVARC_OWNER_EMAIL=
QVARC_OWNER_PASSWORD=

# Оплата. Пока нет ключей Сбера — тестовая оплата (настоящие деньги не списываются).
PAYMENT_PROVIDER=sandbox
ALLOW_SANDBOX_PAYMENTS=true
SANDBOX_WEBHOOK_SECRET=
# PAYMENT_PROVIDER=sber
# SBER_USERNAME=
# SBER_PASSWORD=
# SBER_API_URL=https://ecomtest.sberbank.ru/ecomm/gw/partner/api/v1/

# Почта для кода входа в приложение. Без неё вход гостей в приложение выключен.
SMTP_URL=
MAIL_FROM=
