          }
        }
      }
    },
    "Dejamos la mejor copia de cada foto (marcada con ★) y seleccionamos el resto.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We keep the best copy of each photo (marked ★) and select the rest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучшую копию каждого фото (★) оставляем, остальные отмечены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкращу копію кожного фото (★) залишаємо, решту позначено."
          }
        }
      }
    },
