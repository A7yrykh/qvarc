    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revende usa la cámara para hacer fotos de los artículos que vendes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revende uses the camera to take photos of the items you sell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Revende использует камеру, чтобы фотографировать вещи, которые вы продаёте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Revende використовує камеру, щоб фотографувати речі, які ви продаєте."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revende guarda en Fotos las imágenes preparadas para tus anuncios."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revende saves the images prepared for your listings to Photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Revende сохраняет в «Фото» изображения, подготовленные для объявлений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Revende зберігає у «Фото» зображення, підготовлені для оголошень."
          }
        }
      }
    }
  }
