{
  "sourceLanguage": "es",
  "strings": {
    "%@ informará de tus ventas de este año a Hacienda.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will report this year's sales to the tax agency."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сообщит о ваших продажах за этот год в налоговую."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ повідомить податкову про ваші продажі за цей рік."
          }
        }
      }
    },
    "%@: sin comisión para el vendedor particular. Cámbialo en Ajustes si eres Pro.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: no fee for private sellers. Change it in Settings if you sell as a business."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: частный продавец не платит комиссию. Если вы продаёте как бизнес, измените это в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: приватний продавець не платить комісію. Якщо ви продаєте як бізнес, змініть це в Налаштуваннях."
          }
        }
      }
    },
    "%lld artículos · días medios de venta: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld items · average days to sell: %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вещей: %1$lld · в среднем дней до продажи: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Речей: %1$lld · у середньому днів до продажу: %2$@"
          }
        }
      }
    },
    "%lld de %lld artículos gratis": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld free items"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld из %2$lld бесплатных вещей"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld з %2$lld безкоштовних речей"
          }
        }
      }
    },
    "%lld ventas": {
      "localizations": {
