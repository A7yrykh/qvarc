    "Activa Apple Intelligence en Ajustes para textos con IA.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Apple Intelligence in Settings for AI texts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Apple Intelligence в Настройках, чтобы писать тексты с ИИ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Apple Intelligence у Параметрах, щоб писати тексти зі ШІ."
          }
        }
      }
    },
