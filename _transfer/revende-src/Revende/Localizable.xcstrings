    "Apple Intelligence no está disponible. Usamos una plantilla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence isn't available. Using a template."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence недоступен. Используем шаблон."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence недоступний. Використовуємо шаблон."
          }
        }
