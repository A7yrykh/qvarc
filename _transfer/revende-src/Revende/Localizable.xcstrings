    "Añade lo que quieres vender: haz fotos, crea el anuncio con IA y controla cuánto ganas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add what you want to sell: take photos, create the listing with AI and track what you earn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте, что хотите продать: сделайте фото, создайте объявление с ИИ и считайте заработок."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте, що хочете продати: зробіть фото, створіть оголошення зі ШІ та рахуйте заробіток."
          }
        }
      }
    },
