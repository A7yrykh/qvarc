    },
    "Apple Intelligence se está descargando. Mientras tanto, usamos una plantilla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence is downloading. Using a template for now."
          }
        },
        "ru": {
