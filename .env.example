DATABASE_URL=postgres://postgres:dev@localhost:5432/qvarc_dev
DATABASE_URL_TEST=postgres://postgres:dev@localhost:5432/qvarc_test
COOKIE_SECURE=false
SESSION_HOURS=12
PORT=3000
BOOKING_SITE_URL=http://localhost:3200
API_PUBLIC_URL=http://localhost:3000
# sandbox — тестовая оплата без денег; sber — интернет-эквайринг Сбербанка
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=change-me
# Сбер: логин и пароль API-пользователя магазина (выдаёт банк). Тест: ecomtest, работа: https://ecommerce.sberbank.ru/ecomm/gw/partner/api/v1/
SBER_API_URL=https://ecomtest.sberbank.ru/ecomm/gw/partner/api/v1/
SBER_USERNAME=
SBER_PASSWORD=
# json для ecommerce.sberbank.ru, form для старого адреса securepayments.sberbank.ru/payment/rest/
SBER_API_FORMAT=json
# Ключ контрольной суммы уведомлений из личного кабинета Сбера (если включена симметричная подпись)
SBER_CALLBACK_SECRET=
# Адрес уведомлений: <API_PUBLIC_URL>/public/v1/payments/webhook. Пусто — берётся из личного кабинета
SBER_CALLBACK_URL=
SBER_SESSION_TIMEOUT_SECS=1200
JOBS=true

# Гостевое приложение: вход по коду из письма на e-mail гостя.
# SMTP_URL — почтовый ящик для отправки, например smtps://info%40домен:пароль@smtp.timeweb.ru:465
#   (пароль только здесь, в коде и переписке его нет). MAIL_FROM — тот же ящик: Кварц <info@домен>.
# Без SMTP_URL вне рабочей среды письма пишутся в журнал сервера (MAIL_MODE=log), в рабочей среде вход выключен.
# GUEST_TEST_CODE=123456 — постоянный код для проверки без почты (в рабочей среде запрещён)
SMTP_URL=
MAIL_FROM=
GUEST_TEST_CODE=

# Ключ шифрования паспортных данных из онлайн-регистрации: openssl rand -base64 32
# Хранить только на сервере; при потере ключа сохранённые документы не прочитать.
DOCUMENTS_KEY=
